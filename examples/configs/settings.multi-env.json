{
  "$schema": "app-settings.json.cue",
  "vartrack": {
    "default": {
      "app": {
        "name": "checkout-api",
        "log_level": "info"
      },
      "database": {
        "host": "db.internal",
        "port": 5432,
        "pool": {
          "min": 2,
          "max": 10
        }
      },
      "features": {
        "dark_mode": false,
        "beta_api": false
      },
      "allowed_origins": [
        "https://checkout.example.com"
      ]
    },
    "staging": {
      "database": {
        "host": "db.staging.internal"
      },
      "features": {
        "beta_api": true
      },
      "allowed_origins": [
        "https://staging.checkout.example.com",
        "http://localhost:3000"
      ]
    },
    "production": {
      "app": {
        "log_level": "warn"
      },
      "database": {
        "host": "db.prod.internal",
        "pool": {
          "max": 100
        }
      }
    }
  }
}
