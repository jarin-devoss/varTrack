# Ignore rules for orchestrator-service/docker/Dockerfile. The build context is
# the repository root, so paths are from there.

# Version control
.git
.gitignore

# Other services and tooling: nothing of them goes in this image
gateway-service/
watcher-service/
cli/
libs/
ui/
e2e/
docs/
examples/
**/node_modules

# Python bytecode / cache
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.Python
**/*.egg-info
orchestrator-service/dist/
orchestrator-service/build/
orchestrator-service/.eggs/

# Virtual environments
orchestrator-service/env/
orchestrator-service/venv/
orchestrator-service/.venv/

# Tests
orchestrator-service/tests/

# Rust build artifacts (rust_core)
orchestrator-service/rust_core/target/
**/*.so

# Generated stubs: always regenerated by the proto stage
orchestrator-service/app/generated/

# IDE / editor
.idea/
.vscode/
**/*.swp
**/*.swo

# Documentation
orchestrator-service/README.md

# CI
.github/

# Local config / secrets
**/*.env
**/.env*
