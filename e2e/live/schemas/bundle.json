[
  {
    "platform": "gitea",
    "datasource": "mongo",
    "tenant_id": "default",
    "repo_url": "http://gitea:3000/vartrack-demo/demo-configs.git",
    "file_name": "app-settings.yaml",
    "repositories": [
      "vartrack-demo/demo-configs"
    ],
    "branch": "main",
    "branch_map": {
      "main": "production",
      "develop": "staging"
    },
    "sync_mode": "AUTO",
    "prune": true,
    "self_heal": true,
    "mongo_uri": "mongodb://mongo:27017",
    "database": "vartrack",
    "collection": "variables",
    "update_strategy": "STRATEGY_KEY_VALUE",
    "secrets": {
      "default": {
        "type": "vault",
        "vault_addr": "http://vault:8200",
        "auth": {
          "type": "token",
          "token": "root"
        },
        "mount_point": "secret",
        "path_prefix": "vartrack/configs",
        "kv_version": 2
      }
    }
  },
