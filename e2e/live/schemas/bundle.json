{
  "extends": [
    "local>vartrack-demo/presets:production"
  ],
  "rules": [
    {
      "platform": "gitea",
      "datasource": "mongo-primary",
      "branch": "main",
      "branch_map": {
        "main": "production"
      }
    },
    {
      "platform": "gitea",
      "datasource": "zookeeper",
      "branch": "main",
      "key_format": "slash",
      "branch_map": {
        "main": "production"
      }
    },
    {
      "platform": "gitea",
      "datasource": "redis",
      "branch": "main",
      "branch_map": {
        "main": "production"
      }
    },
    {
      "platform": "gitea",
      "datasource": "s3-minio",
      "branch": "main",
      "branch_map": {
        "main": "production"
      }
    },
    {
      "platform": "gitea",
      "datasource": "configmap-checkout",
      "branch": "main",
      "key_format": "dot",
      "branch_map": {
        "main": "production"
      }
    },
    {
      "platform": "gitea",
      "datasource": "helm-checkout",
      "branch": "main",
      "helm_values_mode": "file",
      "branch_map": {
        "main": "production"
      }
    }
  ]
}
