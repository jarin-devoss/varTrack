{
  "extends": [
    "local>vartrack-demo/presets:production"
  ],
  "rules": [
    {
      "platform": "gitea",
      "datasource": "mongo-primary",
      "branch": "main"
    },
    {
      "platform": "gitea",
      "datasource": "zookeeper",
      "branch": "main",
      "key_format": "slash"
    },
    {
      "platform": "gitea",
      "datasource": "redis",
      "branch": "main"
    },
    {
      "platform": "gitea",
      "datasource": "s3-minio",
      "branch": "main"
    },
    {
      "platform": "gitea",
      "datasource": "configmap-checkout",
      "branch": "main",
      "key_format": "dot"
    },
    {
      "platform": "gitea",
      "datasource": "helm-checkout",
      "branch": "main",
      "helm_values_mode": "file"
    }
  ]
}
