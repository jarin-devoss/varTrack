[
  {
    "platform": "gitea",
    "datasource": "redis-string",
    "repo_url": "http://gitea:3000/vartrack-demo/demo-configs.git",
    "file_name": "app-settings.yaml",
    "repositories": [
      "vartrack-demo/demo-configs"
    ],
    "branch_as_env": false,
    "branch": "main",
    "sync_mode": "SYNC_MODE_GIT_UPSERT_ALL",
    "self_heal": false,
    "redis_hosts": [
      "redis:6379"
    ],
    "redis_db": 3,
    "redis_data_structure": "STRING",
    "data_structure": "string",
    "destination_template": "vartrack:kv",
    "branch_map": {
      "main": "default"
    }
  }
]
