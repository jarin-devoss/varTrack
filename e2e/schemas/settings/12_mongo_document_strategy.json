[
  {
    "platform": "github",
    "datasource": "mongo-document",
    "repo_url": "http://gitea:3000/vartrack-demo/demo-configs.git",
    "file_name": "app-settings.yaml",
    "repositories": [
      "vartrack-demo/demo-configs"
    ],
    "branch_as_env": true,
    "branch": "main",
    "sync_mode": "SYNC_MODE_FULL",
    "prune": true,
    "self_heal": false,
    "mongo_uri": "mongodb://mongo:27017",
    "database": "vartrack",
    "update_strategy": "STRATEGY_DOCUMENT",
    "destination_template": "{env}-documents"
  }
]
