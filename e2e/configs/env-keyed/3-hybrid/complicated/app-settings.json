{
  "service": "checkout-api",
  "timeout_ms": 3000,
  "debug": false,
  "database": {
    "port": 5432,
    "pool": {
      "max": 10
    }
  },
  "log_level": {
    "default": "info",
    "production": "warn"
  },
  "default": {
    "database": {
      "host": "db.internal"
    },
    "replicas": 2
  },
  "staging": {
    "database": {
      "host": "db.staging.internal"
    },
    "debug": true
  },
  "production": {
    "database": {
      "host": "db.prod.internal",
      "pool": {
        "max": 100
      }
    },
    "replicas": 6,
    "timeout_ms": 1500
  }
}
