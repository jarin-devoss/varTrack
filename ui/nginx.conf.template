server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    # The bundle and the JSON the UI polls shrink to about a quarter.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Resolve upstreams per request, so nginx starts even when a service
    # (the optional watcher, say) is absent; that path then answers 502.
    resolver ${RESOLVER} valid=30s ipv6=off;

    # Same paths as the Vite dev proxy, so the UI's defaults work unchanged.
    location /api/gateway/ {
        set $upstream ${GATEWAY_URL};
        rewrite ^/api/gateway/(.*)$ /$1 break;
        proxy_pass $upstream;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location /api/orchestrator/ {
        set $upstream ${ORCHESTRATOR_URL};
        rewrite ^/api/orchestrator/(.*)$ /$1 break;
        proxy_pass $upstream;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location /api/watcher/ {
        set $upstream ${WATCHER_URL};
        rewrite ^/api/watcher/(.*)$ /$1 break;
        proxy_pass $upstream;
    }

    # A location with its own add_header drops the server-level ones, so the
    # security headers are repeated below.

    # Hashed build assets never change.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Client-side routes fall back to the app shell.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        try_files $uri /index.html;
    }
}
