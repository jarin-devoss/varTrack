    "drift.healing": {
      "spec": "12-drift-and-heal"
    },
    "drift.heal_failed": {
      "spec": "12-drift-and-heal"
    },
    "drift.unknown": {
      "spec": "20-failures"
    },
    "drift.not_watched": {
      "reason": "The orchestrator never sends it: it compares every rule, with or without self-heal, so a rule that is not watched reads drifted or in_sync (spec 12 checks that, and the page's wording for it). Only the UI's status table holds the value."
    },
    "task.PENDING": {
      "spec": "20-failures",
      "contains": "queued"
    },
    "task.RUNNING": {
      "spec": "20-failures"
    },
    "task.RETRYING": {
      "reason": "A worker retries a task only for a connection error it can recover from within seconds; no sink of the stack can be made to fail that way and then recover on cue. The wording of the state is held by the UI's unit tests (src/lib)."
    },
    "task.SUCCEEDED": {
      "spec": "16-task-detail"
    },
    "task.FAILED": {
      "spec": "16-task-detail"
    },
    "file.ok": {
      "spec": "16-task-detail",
      "contains": "Written"
    },
    "file.empty": {
      "reason": "A file without keys never reaches the sink: it is skipped first (file.skipped, spec 16), so the sink-stage 'empty' result cannot be produced through the product today. The wording is held by the UI's status table."
    },
    "file.validation_failed": {
      "spec": "20-failures"
    },
    "file.error": {
      "spec": "20-failures"
    },
    "file.skipped": {
      "spec": "16-task-detail",
      "contains": "Skipped"
    },
    "file.aborted": {
      "spec": "20-failures"
    },
    "file.partial": {
      "reason": "Needs a sink that writes, cannot take the write back, and fails on a later file; the stack's sinks that write several files all restore (spec 20 shows rolled_back). Held by the orchestrator tests of the sink commit (tests/unit/test_sink_commits.py) and the UI's status table."
    },
    "trigger.webhook": {
      "spec": "15-tasks"
    },
    "trigger.cli": {
      "spec": "15-tasks"
    },
